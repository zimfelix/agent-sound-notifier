{
  "name": "agent-sound-notifier",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Three add-ons for coding agents: completion sound (+ tab dot), Claude Code status line, and the 'Strukturiert' output style; macOS and Windows.",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions/",
    "hooks/",
    "statusline/",
    "output-style/",
    "install.py",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^22.19.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/agent-sound-notifier.ts"
    ]
  }
}
